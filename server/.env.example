# CivicResolve Municipal Server Environment Configuration
# Node environment ('development' | 'production' | 'test')
PORT=5000
NODE_ENV=development

# Allowed CORS client URL in production (e.g., https://civicresolve.gov.in)
CLIENT_URL=http://localhost:5173

# SQLite database storage path
DATABASE_PATH=./data/civicresolve.db

# File upload directory and maximum file size (MB)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Cryptographic Authentication (JWT)
# Generate a cryptographically strong secret (e.g. `openssl rand -base64 48`)
JWT_SECRET=your_production_jwt_secret_min_32_characters_here

# Reverse Proxy & Trusted Proxy Configuration ('loopback' | '1' | '127.0.0.1' | specific proxy IP)
TRUST_PROXY=loopback

# SQLite Dedicated Online Backup Directory
BACKUP_DIR=./backups

# Gemini AI Integration (Exclusively kept on backend - never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here


